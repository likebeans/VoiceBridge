# Required: a fixed key shared with your business backend, sent as X-API-Key.
# Generate once with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Use 32–256 ASCII letters, digits, _ or -. Never expose this key in browser code.
SERVICE_API_KEY=

# Configure at least one upstream key.
#
# Qwen (Alibaba Cloud Model Studio / DashScope)
# Get a key and the workspace Base URL:
# https://bailian.console.aliyun.com/cn-beijing/model/settings/api-key
# Official realtime docs:
# https://help.aliyun.com/zh/model-studio/qwen-asr-realtime-interaction-process
# The legacy Beijing endpoint below still works. If the console shows a
# workspace endpoint, use it instead, for example:
# wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# This repository implements the official Qwen path, but has not verified a
# real Qwen call yet. Keys, model access and region must match.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_MODEL=qwen3-asr-flash-realtime

# FunASR is supported through the DashScope-style realtime task protocol of
# the specific MaaS gateway configured below. This is not a generic client for
# an arbitrary self-hosted open-source FunASR deployment.
# Gateway: https://maas.marketingforce.com/
# Get a key: https://maas.marketingforce.com/login
# Access requires an account and ASR model permission. The login page does not
# show a verifiable self-service signup flow; availability is up to the gateway.
MAAS_API_KEY=
MAAS_BASE_URL=https://maas.marketingforce.com
FUNASR_MODEL=fun-asr-realtime

MAX_SESSION_SECONDS=120
MAX_AUDIO_SECONDS=120
MAX_CONNECTIONS=100
START_TIMEOUT_SECONDS=5
CONNECT_TIMEOUT_SECONDS=5
OPEN_TIMEOUT_SECONDS=12
PRE_READY_BUFFER_SECONDS=3
# Optional: switch on startup failure if language coverage is compatible (qwen or funasr).
# Auto mode requires the fallback to cover every known language of the requested model.
# FALLBACK_PROVIDER=
SHUTDOWN_GRACE_SECONDS=180
IDLE_TIMEOUT_SECONDS=15
FINISH_TIMEOUT_SECONDS=15
SEND_TIMEOUT_SECONDS=5
MAX_AUDIO_CHUNK_BYTES=16384
MAX_CONTROL_MESSAGE_BYTES=8192
VAD_SILENCE_DURATION_MS=400
HOST=0.0.0.0
PORT=8000

# Clients may omit provider (or send null); the service then selects a
# configured provider, preferring qwen when both are configured. An explicitly
# named but unconfigured provider is still rejected.

