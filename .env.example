# Configure at least one upstream key; Qwen keys must match the selected region.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_MODEL=qwen3-asr-flash-realtime

# Required: a fixed key shared with your business backend, sent as X-API-Key.
# Generate once with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Use 32–256 ASCII letters, digits, _ or -. Never expose this key in browser code.
SERVICE_API_KEY=

MAX_SESSION_SECONDS=120
MAX_AUDIO_SECONDS=120
MAX_CONNECTIONS=100
START_TIMEOUT_SECONDS=5
CONNECT_TIMEOUT_SECONDS=5
OPEN_TIMEOUT_SECONDS=12
PRE_READY_BUFFER_SECONDS=3
# Optional: switch on startup failure if language coverage is compatible (qwen or funasr).
# Auto mode requires the fallback to cover every known language of the requested model.
# FALLBACK_PROVIDER=
SHUTDOWN_GRACE_SECONDS=180
IDLE_TIMEOUT_SECONDS=15
FINISH_TIMEOUT_SECONDS=15
SEND_TIMEOUT_SECONDS=5
MAX_AUDIO_CHUNK_BYTES=16384
VAD_SILENCE_DURATION_MS=400
HOST=0.0.0.0
PORT=8000

# MaaS gateway (fun-asr-realtime)
MAAS_API_KEY=
MAAS_BASE_URL=https://maas.marketingforce.com
FUNASR_MODEL=fun-asr-realtime
